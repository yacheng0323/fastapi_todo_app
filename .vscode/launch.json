{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🧪 Debug FastAPI (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app", // ← 這裡 main 是你的 module，app 是變數名
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}